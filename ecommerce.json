				"auth": {
					"type": "noauth"
				}
			},
			"response": []
		},
		{
			"name": "Create",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"url": "{{baseUrl}}/products",
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"iPhone 17\",\n  \"category\": \"electronics\",\n  \"description\": \"Lorem ipsum...\",\n  \"price\": 2299.99,\n  \"currency\": \"USD\",\n  \"available_quantity\": 200,\n  \"sold_from\": null,\n  \"sold_to\": null\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{token}}",
							"type": "string"
						}
					]
				}
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"if (pm.response.code === 201) {",
							"  pm.collectionVariables.set('productId', pm.response.json().id);",
							"}"
						]
					}
				}
			]
		},
		{
